# Connection string pooled (via PgBouncer en Railway). La app la usa en runtime.
DATABASE_URL=postgres://user:password@localhost:5432/nextjs_rbac_template

# Connection string unpooled (conexion directa). Usada solo por migraciones y seed.
DATABASE_URL_UNPOOLED=postgres://user:password@localhost:5432/nextjs_rbac_template

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
